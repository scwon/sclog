{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [".claude/**", ".specify/**", "specs/**", "dist/**", "storybook-static/**"],
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": ["src/layouts/**", "src/components/**", "src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/design-system/**", "!**/design-system/styles/index.css"],
                "message": "소비자는 디자인 시스템을 '@/design-system'(index.ts)과 CSS 진입점(styles/index.css)으로만 가져온다. 필요한 것이 없으면 index.ts에서 export한다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/design-system/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^astro(:|/|$)",
                "message": "디자인 시스템은 Astro에 의존하지 않는다(ADR 0001·0002). Astro 쪽 일은 소비자(레이아웃·페이지)가 맡는다."
              },
              {
                "regex": "\\.astro$",
                "message": "디자인 시스템은 Astro 컴포넌트를 가져오지 않는다(ADR 0001·0002)."
              },
              {
                "regex": "^@/(components|layouts|pages|utils|content|site)(/|$)",
                "message": "디자인 시스템은 소비자 코드를 가져오지 않는다. 값은 props로 받는다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/qa/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "waitForTimeout",
            "message": "QA 스크립트는 고정 대기를 쓰지 않는다. ego-browser 자동화 탭은 2fps 안팎으로 그려져 시간을 믿을 수 없다. 그 단계가 기다리는 조건을 scripts/qa/wait.mjs의 until·navigate·goto·reload로 기다린다."
          },
          {
            "object": "window",
            "property": "setTimeout",
            "message": "QA 스크립트는 setTimeout으로 잠들지 않는다. 조건은 scripts/qa/wait.mjs의 until로 기다린다."
          },
          {
            "object": "globalThis",
            "property": "setTimeout",
            "message": "QA 스크립트는 setTimeout으로 잠들지 않는다. 조건은 scripts/qa/wait.mjs의 until로 기다린다."
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "QA 스크립트는 setTimeout으로 잠들지 않는다. 조건은 scripts/qa/wait.mjs의 until로 기다린다. 시간 자체가 필요한 줄만 `// oxlint-disable-next-line no-restricted-globals -- 이유`로 허용한다."
          }
        ]
      }
    }
  ]
}
