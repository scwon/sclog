---
/**
 * 모든 화면의 레이아웃: 전체 화면 IDE 창.
 * 창 틀(`Shell`)은 화면을 옮겨도 남는 아일랜드 하나이고(ADR 0001), 에디터 내용은 아래 `<main id="editor">` 안의
 * 정적 HTML이다. 에디터 루트의 `data-file-*`와 개요 JSON이 페이지 ↔ 창 틀 계약이다.
 * `<html>`의 `transition:name="root"`는 테마 퍼짐(motion.css)이 고르는 전환 이름이다. 화면 이동 움직임은 `none`으로 끈다.
 */
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import { Shell } from '@/design-system';
import { PROFILE, SITE } from '../site';
import { getPublishedPosts } from '../utils/blog';
import { buildTree, fileCrumbs, type IdeFile, type IdeOutlineItem } from '../utils/ide';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** 에디터에 열린 파일. 탭·창 제목·상태줄·경로 표시줄이 이 값을 쓴다. */
  file: IdeFile;
  /** 글의 개요(탐색기 아래). */
  outline?: IdeOutlineItem[];
}

const {
  title,
  description = 'SCLOG - 개발 블로그',
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  file,
  outline,
} = Astro.props;

const tree = buildTree(await getPublishedPosts('posts'));

// 경로 표시줄: posts › 2023 › <파일>.mdx, ai-written › ai-written.log, tags › <태그>
const crumbs = fileCrumbs(file);

// `</script>`로 JSON이 끊기지 않게 `<`를 이스케이프한다.
const outlineJson =
  outline && outline.length > 0 ? JSON.stringify(outline).replaceAll('<', '\\u003c') : undefined;
---

<!doctype html>
<html lang="ko" transition:animate="none" transition:name="root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 첫 페인트 전에 테마를 정한다: 저장값 → 시스템 설정 → 어두운 테마.
         화면을 옮길 때는 <html> 속성이 새 문서 것으로 바뀌므로 바꾸기 직전에 지금 테마를 옮겨 붙인다. -->
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
        if (!window.sclogThemeCarry) {
          window.sclogThemeCarry = true;
          document.addEventListener('astro:before-swap', function (event) {
            var root = document.documentElement;
            var next = event.newDocument.documentElement;
            next.setAttribute('data-theme', root.getAttribute('data-theme') || 'dark');
            // 창 틀의 패널 상태(열기·닫기)도 이어 붙인다.
            var panel = root.getAttribute('data-panel');
            if (panel) next.setAttribute('data-panel', panel);
          });
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    <ClientRouter />
  </head>
  <body>
    <a class="ide-skip" href="#editor">
      본문으로 건너뛰기
    </a>
    <Shell
      client:load
      transition:persist="shell"
      brand={SITE.brand}
      author={SITE.author}
      githubUrl={SITE.githubUrl}
      sourceUrl={SITE.sourceUrl}
      tree={tree}
      profile={PROFILE}
      searchIndexUrl="/search-index.json"
      current={{ title: file.title, path: file.path, url: file.url, kind: file.kind }}
    />
    <main
      id="editor"
      class="ide-editor"
      tabindex="-1"
      data-file-title={file.title}
      data-file-path={file.path}
      data-file-url={file.url}
      data-file-kind={file.kind}
      data-file-size={file.size}
      data-file-reading={file.reading}
      data-file-summary={file.summary}
    >
      <div class="ide-crumbs">
        <ol class="ide-crumbs-path" aria-label="위치">
          {crumbs.map((crumb) => (
            <li aria-current={crumb.current ? 'page' : undefined}>
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : crumb.label}
            </li>
          ))}
        </ol>
        <slot name="crumbs-end" />
      </div>
      <slot />
    </main>
    {outlineJson && <script type="application/json" id="editor-outline" set:html={outlineJson} />}
    <script>
      import { REDUCED_MOTION, resetReading, showTab } from '@/design-system';

      /**
       * 펼침: 파일을 열 때 첫 1.4화면 안의 줄·블록을 위에서부터 차례로 보인다(2층 motion.css의 `[data-unfold]`).
       * 펼칠지는 탭 스토어의 `showTab`이 정한다(탭이 새로 생겨 처음 보일 때만). 움직임 줄이기 설정에서는
       * 표시만 남기고 펼치지 않는다. 마지막 항목의 애니메이션이 끝나면 표시를 걷어 낸다.
       */
      const TARGETS = [
        '.flow > .flow-line:not([hidden])',
        '[data-doc] .doc-frontmatter',
        '[data-doc] .doc-head > *',
        '[data-doc] .doc-hero',
        '[data-doc] .doc-prose > *',
      ].join(', ');

      function unfold() {
        const editor = document.getElementById('editor');
        const { fileUrl: url, fileTitle: title, filePath: path } = editor?.dataset ?? {};
        if (!editor || !url || !title || !path || !showTab({ url, title, path })) return;
        if (window.matchMedia(REDUCED_MOTION).matches) return;
        const items = [...editor.querySelectorAll<HTMLElement>(TARGETS)].filter((item) => {
          const { top, bottom } = item.getBoundingClientRect();
          return bottom > 0 && top < window.innerHeight * 1.4;
        });
        if (items.length === 0) return;
        items.forEach((item, index) => {
          item.dataset.unfoldItem = '';
          item.style.setProperty('--i', String(index));
        });
        editor.dataset.unfold = '';
        const finish = () => {
          delete editor.dataset.unfold;
          for (const item of items) {
            delete item.dataset.unfoldItem;
            item.style.removeProperty('--i');
          }
        };
        items.at(-1)?.addEventListener('animationend', finish, { once: true });
        window.setTimeout(finish, 3000);
      }

      document.addEventListener('astro:page-load', unfold);
      // 새 페이지로 바뀌면 읽기 위치를 비운다. 새 페이지의 스크립트가 page-load에서 다시 채운다.
      document.addEventListener('astro:after-swap', resetReading);
    </script>
  </body>
</html>
