---
/**
 * 글 화면: 에디터에 연 파일. frontmatter(코드 색) → 제목·작성 정보 → 대표 이미지(코랄 매트) → 본문 → 꼬리.
 * 모든 블록에 줄 번호가 있고(2층 ide.css의 CSS 카운터), 아래 스크립트가 읽는 위치를 `reading` 스토어에 쓴다.
 * MDX 원본과 글 URL은 바꾸지 않는다.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CodeBlock from '../components/blog/CodeBlock.astro';
import Comments from '../components/blog/Comments.astro';
import { Badge } from '@/design-system';
import { SITE } from '../site';
import { buildOutline, postFile } from '../utils/ide';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const file = postFile(post);
const isoDate = pubDate.toISOString().slice(0, 10);
const quote = (value: string) => JSON.stringify(value);
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  file={file}
  outline={buildOutline(headings)}
>
  <Fragment slot="crumbs-end">
    <span class="ide-crumbs-symbol" data-reading-symbol></span>
    <button
      type="button"
      class="ide-crumbs-outline"
      data-explorer-toggle
      aria-controls="explorer"
      aria-expanded="false"
    >
      개요
    </button>
    <span class="ide-crumbs-progress" aria-hidden="true"></span>
  </Fragment>

  <article class="doc" data-doc>
    <div class="doc-frontmatter" aria-hidden="true">
      <span class="doc-fm-line">
        <span class="doc-fm-punct">---</span>
      </span>
      <span class="doc-fm-line">
        <span class="doc-fm-key">title</span>
        <span class="doc-fm-punct">: </span>
        <span class="doc-fm-str">{quote(title)}</span>
      </span>
      <span class="doc-fm-line">
        <span class="doc-fm-key">pubDate</span>
        <span class="doc-fm-punct">: </span>
        <span class="doc-fm-num">{isoDate}</span>
      </span>
      {tags.length > 0 && (
        <span class="doc-fm-line">
          <span class="doc-fm-key">tags</span>
          <span class="doc-fm-punct">: [</span>
          {tags.map((tag, index) => (
            <>
              <span class="doc-fm-str">{quote(tag)}</span>
              {index < tags.length - 1 && <span class="doc-fm-punct">, </span>}
            </>
          ))}
          <span class="doc-fm-punct">]</span>
        </span>
      )}
      {heroImage && (
        <span class="doc-fm-line">
          <span class="doc-fm-key">heroImage</span>
          <span class="doc-fm-punct">: </span> <span class="doc-fm-str">{quote(heroImage)}</span>
        </span>
      )}
      <span class="doc-fm-line">
        <span class="doc-fm-punct">---</span>
      </span>
    </div>

    <header class="doc-head">
      <h1 class="doc-title">{title}</h1>
      <p class="doc-byline">
        <span class="doc-sign" aria-hidden="true">
          ’
        </span>
        <span class="doc-byline-author">{SITE.author}</span>
        <span class="doc-byline-sep" aria-hidden="true"></span>
        <time datetime={isoDate}>{isoDate.replaceAll('-', '.')}</time>
        <span class="doc-byline-sep" aria-hidden="true"></span>
        <span>읽는 시간 {file.reading}분</span>
      </p>
    </header>

    {heroImage && (
      <figure class="doc-hero">
        <img src={heroImage} alt={`${title} 대표 이미지`} />
      </figure>
    )}

    <div class="doc-prose" id="content">
      <slot />
    </div>

    <footer class="doc-foot">
      {tags.length > 0 && (
        <ul class="doc-tags" aria-label="태그">
          {tags.map((tag) => (
            <li>
              <Badge asChild>
                <a href={`/blog/tags/${tag}/`}>{tag}</a>
              </Badge>
            </li>
          ))}
        </ul>
      )}
      <div class="doc-author">
        <span class="doc-sign" aria-hidden="true">
          ’
        </span>
        <div>
          <p class="doc-author-name">{SITE.author}</p>
          <a href={SITE.githubUrl}>{SITE.githubUrl.replace(/^https?:\/\//, '')}</a>
        </div>
      </div>
      <nav class="doc-end" aria-label="글 끝 이동">
        <a href="/">← posts.log</a>
        <a href="#editor">맨 위로</a>
      </nav>
      <Comments />
    </footer>
  </article>
  <CodeBlock />
</BaseLayout>

<script>
  import {
    currentBlock,
    locateInOutline,
    readingPercent,
    readingSymbol,
    setReading,
    type OutlineItem,
  } from '@/design-system';

  /**
   * 읽는 위치를 따라간다: 현재 블록(줄 번호 코랄), 현재 장·절, 읽은 비율.
   * 블록이 읽는 선을 지날 때는 IntersectionObserver가, 비율은 스크롤이 알려 준다.
   * 번들 스크립트는 한 번만 돌므로 페이지가 열릴 때마다 다시 붙이고, 떠날 때 뗀다.
   */
  let detach: (() => void) | null = null;

  /**
   * 읽는 선: 탭·경로 표시줄 바로 아래(html의 scroll-padding-top과 같은 값). 앵커로 이동하면 제목이 정확히 이 선에
   * 맞춰지므로, 소수점 픽셀 차이로 아직 안 지난 것으로 보지 않게 몇 픽셀 여유를 둔다.
   */
  function readingLine() {
    return (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 140) + 8;
  }

  function attach() {
    detach?.();
    detach = null;
    const doc = document.querySelector<HTMLElement>('[data-doc]');
    if (!doc) return;
    const blocks = [
      ...doc.querySelectorAll<HTMLElement>('.doc-fm-line, .doc-title, .doc-byline, .doc-prose > *'),
    ];
    const symbol = document.querySelector<HTMLElement>('[data-reading-symbol]');
    let outline: OutlineItem[] = [];
    try {
      outline = JSON.parse(document.getElementById('editor-outline')?.textContent ?? '[]');
    } catch {
      outline = [];
    }
    const crumbs = document.querySelector<HTMLElement>('.ide-crumbs');
    let current: HTMLElement | null = null;
    let frame = 0;
    const update = () => {
      frame = 0;
      const index = currentBlock(
        blocks.map((block) => block.getBoundingClientRect().top),
        readingLine(),
      );
      if (blocks[index] !== current) {
        current?.classList.remove('is-current');
        current = blocks[index] ?? null;
        current?.classList.add('is-current');
      }
      // 장·절의 구분은 탐색기 개요(계약 JSON)를 따른다. 글의 최상위 제목 단계와 상관없다.
      const passed = blocks.slice(0, index + 1).flatMap((block) => (block.id ? [block.id] : []));
      const { chapter, section } = locateInOutline(outline, passed);
      const percent = readingPercent({
        scrollTop: window.scrollY,
        scrollHeight: document.documentElement.scrollHeight,
        clientHeight: window.innerHeight,
      });
      setReading({ line: index + 1, chapter, section, percent });
      if (symbol) symbol.textContent = readingSymbol({ chapter, section });
      crumbs?.style.setProperty('--progress', String(percent / 100));
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const observer = new IntersectionObserver(schedule, {
      rootMargin: `-${readingLine()}px 0px -55% 0px`,
    });
    for (const block of blocks) observer.observe(block);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();

    detach = () => {
      observer.disconnect();
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      cancelAnimationFrame(frame);
      crumbs?.style.removeProperty('--progress');
    };
  }

  document.addEventListener('astro:page-load', attach);
  document.addEventListener('astro:before-swap', () => {
    detach?.();
    detach = null;
  });
</script>
