---
/**
 * 글 화면: 에디터에 연 파일. frontmatter(코드 색) → 제목·작성 정보 → 대표 이미지(코랄 매트) → 본문 → 꼬리.
 * 모든 블록에 줄 번호가 있고(2층 ide.css의 CSS 카운터), 아래 스크립트가 읽는 위치를 `reading` 스토어에 쓴다.
 * 두 번째 스크립트는 장·절 제목의 장 주소 복사 버튼(`ChapterLink.astro`)을 드러내고 누름과 들어왔을 때 강조를 맡는다.
 * MDX 원본과 글 URL은 바꾸지 않는다.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CodeBlock from '../components/blog/CodeBlock.astro';
import Comments from '../components/blog/Comments.astro';
import { Badge, nextFile } from '@/design-system';
import { SITE } from '../site';
import { getPublishedPosts } from '../utils/blog';
import { buildOutline, buildTree, docEndLinks, postFile } from '../utils/ide';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const file = postFile(post);
const isoDate = pubDate.toISOString().slice(0, 10);
const quote = (value: string) => JSON.stringify(value);
const endLinks = docEndLinks(nextFile(buildTree(await getPublishedPosts()), file.url));
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  file={file}
  outline={buildOutline(headings)}
>
  <Fragment slot="crumbs-end">
    <span class="ide-crumbs-symbol" data-reading-symbol></span>
    <button
      type="button"
      class="ide-crumbs-outline"
      data-explorer-toggle
      aria-controls="panel"
      aria-expanded="false"
    >
      개요
    </button>
    <span class="ide-crumbs-progress" aria-hidden="true"></span>
  </Fragment>

  <article class="doc" data-doc>
    <div class="doc-frontmatter" aria-hidden="true">
      <span class="doc-fm-line">
        <span class="doc-fm-punct">---</span>
      </span>
      <span class="doc-fm-line">
        <span class="doc-fm-key">title</span>
        <span class="doc-fm-punct">: </span>
        <span class="doc-fm-str">{quote(title)}</span>
      </span>
      <span class="doc-fm-line">
        <span class="doc-fm-key">pubDate</span>
        <span class="doc-fm-punct">: </span>
        <span class="doc-fm-num">{isoDate}</span>
      </span>
      {tags.length > 0 && (
        <span class="doc-fm-line">
          <span class="doc-fm-key">tags</span>
          <span class="doc-fm-punct">: [</span>
          {tags.map((tag, index) => (
            <>
              <span class="doc-fm-str">{quote(tag)}</span>
              {index < tags.length - 1 && <span class="doc-fm-punct">, </span>}
            </>
          ))}
          <span class="doc-fm-punct">]</span>
        </span>
      )}
      {heroImage && (
        <span class="doc-fm-line">
          <span class="doc-fm-key">heroImage</span>
          <span class="doc-fm-punct">: </span> <span class="doc-fm-str">{quote(heroImage)}</span>
        </span>
      )}
      <span class="doc-fm-line">
        <span class="doc-fm-punct">---</span>
      </span>
    </div>

    <header class="doc-head">
      <h1 class="doc-title">{title}</h1>
      <p class="doc-byline">
        <span class="doc-sign" aria-hidden="true">
          ’
        </span>
        <span class="doc-byline-author">{SITE.author}</span>
        <span class="doc-byline-sep" aria-hidden="true"></span>
        <time datetime={isoDate}>{isoDate.replaceAll('-', '.')}</time>
        <span class="doc-byline-sep" aria-hidden="true"></span>
        <span>읽는 시간 {file.reading}분</span>
      </p>
    </header>

    {heroImage && (
      <figure class="doc-hero">
        <img src={heroImage} alt={`${title} 대표 이미지`} />
      </figure>
    )}

    <div class="doc-prose" id="content">
      <slot />
    </div>

    <footer class="doc-foot">
      {tags.length > 0 && (
        <ul class="doc-tags" aria-label="태그">
          {tags.map((tag) => (
            <li>
              <Badge asChild>
                <a href={`/blog/tags/${tag}/`}>{tag}</a>
              </Badge>
            </li>
          ))}
        </ul>
      )}
      <div class="doc-author">
        <span class="doc-sign" aria-hidden="true">
          ’
        </span>
        <div>
          <p class="doc-author-name">{SITE.author}</p>
          <a href={SITE.githubUrl}>{SITE.githubUrl.replace(/^https?:\/\//, '')}</a>
        </div>
      </div>
      <nav class="doc-end" aria-label="글 끝 이동">
        <ul class="doc-end-lines">
          {endLinks.map((link) =>
            link.next ? (
              <li class="doc-end-line doc-end-next" data-next-file>
                <a class="doc-end-link" href={link.href} aria-label={link.name}>
                  <span class="doc-end-label">{link.label}</span>
                  <span class="doc-end-rule" aria-hidden="true" />
                  <span class="doc-end-note">{link.note}</span>
                </a>
                {/* 읽음 꼬리표(✓·42%)를 페이지 스크립트가 채우는 자리 */}
                <span class="doc-end-mark" data-next-file-mark />
              </li>
            ) : (
              <li class="doc-end-line">
                <a class="doc-end-link" href={link.href}>
                  <span class="doc-end-label">{link.label}</span>
                </a>
              </li>
            ),
          )}
        </ul>
      </nav>
      <Comments />
    </footer>
  </article>
  <CodeBlock />
</BaseLayout>

<script>
  import {
    $readingHistory,
    currentBlock,
    followResume,
    locateInOutline,
    openResume,
    readingMark,
    readingPercent,
    readingSymbol,
    recordReading,
    setReading,
    type OutlineItem,
  } from '@/design-system';
  import { fillReadingMark } from '../utils/readingMark';

  /**
   * 읽는 위치를 따라간다: 현재 블록(줄 번호 코랄), 현재 장·절, 읽은 비율. 장과 비율은 읽기 기록에도 남긴다
   * (90% 이상이면 읽은 글, 그 아래면 마지막 읽은 위치). 글이 열리면 기록하기 전에 이어 읽기를 권할지 정하고,
   * 읽는 장이 저장된 장에 닿으면 거둔다.
   * 블록이 읽는 선을 지날 때는 IntersectionObserver가, 비율은 스크롤이 알려 준다.
   * 번들 스크립트는 한 번만 돌므로 페이지가 열릴 때마다 다시 붙이고, 떠날 때 뗀다.
   */
  let detach: (() => void) | null = null;

  /**
   * 읽는 선: 탭·경로 표시줄 바로 아래(html의 scroll-padding-top과 같은 값). 앵커로 이동하면 제목이 정확히 이 선에
   * 맞춰지므로, 소수점 픽셀 차이로 아직 안 지난 것으로 보지 않게 몇 픽셀 여유를 둔다.
   */
  function readingLine() {
    return (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 140) + 8;
  }

  function attach() {
    detach?.();
    detach = null;
    const doc = document.querySelector<HTMLElement>('[data-doc]');
    if (!doc) return;
    const blocks = [
      ...doc.querySelectorAll<HTMLElement>('.doc-fm-line, .doc-title, .doc-byline, .doc-prose > *'),
    ];
    const symbol = document.querySelector<HTMLElement>('[data-reading-symbol]');
    let outline: OutlineItem[] = [];
    try {
      outline = JSON.parse(document.getElementById('editor-outline')?.textContent ?? '[]');
    } catch {
      outline = [];
    }
    const crumbs = document.querySelector<HTMLElement>('.ide-crumbs');
    const url = document.getElementById('editor')?.dataset.fileUrl;
    let current: HTMLElement | null = null;
    let frame = 0;
    const update = () => {
      frame = 0;
      const index = currentBlock(
        blocks.map((block) => block.getBoundingClientRect().top),
        readingLine(),
      );
      if (blocks[index] !== current) {
        current?.classList.remove('is-current');
        current = blocks[index] ?? null;
        current?.classList.add('is-current');
      }
      // 장·절의 구분은 탐색기 개요(계약 JSON)를 따른다. 글의 최상위 제목 단계와 상관없다.
      const passed = blocks.slice(0, index + 1).flatMap((block) => (block.id ? [block.id] : []));
      const { chapter, section } = locateInOutline(outline, passed);
      const percent = readingPercent({
        scrollTop: window.scrollY,
        scrollHeight: document.documentElement.scrollHeight,
        clientHeight: window.innerHeight,
      });
      setReading({ line: index + 1, chapter, section, percent });
      followResume(outline, chapter?.id ?? null);
      if (url) recordReading(url, chapter?.id ?? null, percent);
      if (symbol) symbol.textContent = readingSymbol({ chapter, section });
      crumbs?.style.setProperty('--progress', String(percent / 100));
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const observer = new IntersectionObserver(schedule, {
      rootMargin: `-${readingLine()}px 0px -55% 0px`,
    });
    for (const block of blocks) observer.observe(block);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    // 이어 읽기는 이 글의 위치를 새로 기록하기 전에 정해야 지난번 위치를 본다.
    if (url) openResume({ url, outline, hash: location.hash });
    update();

    detach = () => {
      observer.disconnect();
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      cancelAnimationFrame(frame);
      crumbs?.style.removeProperty('--progress');
    };
  }

  /** 다음 파일 줄의 메모 뒤에 그 글의 읽음 꼬리표를 붙인다. 기록이 바뀌거나 화면이 열릴 때마다 다시 그린다. */
  function paintNextFile() {
    const line = document.querySelector<HTMLElement>('li.doc-end-next[data-next-file]');
    const url = line?.querySelector<HTMLAnchorElement>('a.doc-end-link')?.getAttribute('href');
    const slot = line?.querySelector<HTMLElement>('span[data-next-file-mark]');
    if (url && slot) fillReadingMark(slot, readingMark($readingHistory.get(), url), 'short');
  }

  $readingHistory.subscribe(paintNextFile);
  document.addEventListener('astro:page-load', paintNextFile);
  document.addEventListener('astro:page-load', attach);
  document.addEventListener('astro:before-swap', () => {
    detach?.();
    detach = null;
  });
</script>

<script>
  import { closeSelectionToolbar, watchSelectionToolbar } from '@/design-system';
  import { selectionActions } from '../components/blog/selection-actions';

  /**
   * 선택 툴바. 번들 스크립트는 한 번만 돌므로 감시도 한 번만 건다(본문이 없는 화면에서는 아무것도 하지 않는다).
   * 툴바 청크는 처음 본문을 고를 때 불러온다. 화면을 옮기기 전에 상자와 버튼을 걷는다.
   */
  watchSelectionToolbar({ actions: selectionActions, label: '선택 툴바' });
  document.addEventListener('astro:before-swap', closeSelectionToolbar);
</script>

<script>
  import { showStatusNotice, STATUS_NOTICE_MS } from '@/design-system';
  import { chapterLinkNotice, chapterLinkUrl } from '../utils/chapter-link';

  /**
   * 장 주소 복사와 들어왔을 때 강조. 번들 스크립트는 한 번만 돌므로 클릭은 `document`에 위임하고,
   * 버튼 드러내기와 강조는 파일이 열릴 때마다(`astro:page-load`) 한다. 강조는 그 장 제목의 `.is-linked`다.
   */
  const BUTTON = '[data-chapter-link]';
  const copiedTimers = new WeakMap<HTMLElement, number>();

  /** id가 장 주소 대상(복사 버튼이 있는 제목)이면 그 제목. */
  function chapterHeading(id: string): HTMLElement | null {
    const heading = document.getElementById(id);
    return heading?.querySelector(`:scope > .doc-chapter-gutter > ${BUTTON}`) ? heading : null;
  }

  /** 강조를 그 장으로 옮긴다. `null`이면 지운다. */
  function markLinked(heading: HTMLElement | null) {
    for (const marked of document.querySelectorAll('.is-linked')) {
      if (marked !== heading) marked.classList.remove('is-linked');
    }
    heading?.classList.add('is-linked');
  }

  function hashId(): string {
    try {
      return decodeURIComponent(location.hash.slice(1));
    } catch {
      return '';
    }
  }

  // 파일이 열릴 때만 해시를 본다. 같은 화면에서 개요 링크로 해시만 바뀌면 page-load가 오지 않아 강조하지 않는다.
  document.addEventListener('astro:page-load', () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(BUTTON)) {
      button.hidden = false;
    }
    const id = hashId();
    markLinked(id ? chapterHeading(id) : null);
  });

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>(BUTTON);
    const id = button?.dataset.chapterLink;
    if (!button || !id) return;
    // ClientRouter의 기록 상태(index·스크롤)를 잃지 않게 지금 state를 그대로 넘긴다. 스크롤하지 않는다.
    history.replaceState(history.state, '', `#${id}`);
    markLinked(chapterHeading(id));
    let copied = false;
    try {
      await navigator.clipboard.writeText(chapterLinkUrl(location, id));
      copied = true;
    } catch {
      copied = false;
    }
    showStatusNotice(chapterLinkNotice(id, copied));
    if (!copied) return;
    window.clearTimeout(copiedTimers.get(button));
    button.dataset.copied = '';
    copiedTimers.set(
      button,
      window.setTimeout(() => delete button.dataset.copied, STATUS_NOTICE_MS),
    );
  });
</script>
