---
/** 404: 열 수 없는 파일. 갈 곳을 링크 줄로 보인다. */
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowLog from '../components/flow/FlowLog.astro';
import { linkLines } from '../utils/flow';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청하신 페이지가 존재하지 않습니다."
  file={{ title: '페이지를 찾을 수 없습니다', path: '404', url: '/404', kind: 'page' }}
>
  <FlowLog
    lines={linkLines({
      title: '404',
      comment: '요청한 파일을 찾을 수 없다. 주소가 바뀌었거나 없는 파일이다.',
      links: [
        { href: '/', label: 'posts.log', note: '홈 흐름 로그' },
        { href: '/blog/', label: 'posts/', note: '모든 글' },
        { href: '/blog/tags/', label: 'tags/', note: '태그 목록' },
      ],
    })}
  />
</BaseLayout>
