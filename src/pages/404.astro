---
/**
 * 404: 열 수 없는 파일. 갈 곳을 링크 줄로 보인다. 폴더마다 로그 → 글 목록(있는 폴더만) → 태그 목록이고,
 * 이름·주소는 폴더 표(`FOLDER_ROUTES`)에서 읽는다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowLog from '../components/flow/FlowLog.astro';
import { linkLines } from '../utils/flow';
import { FOLDER_ROUTES, FOLDERS } from '../utils/folder';

const routes = FOLDERS.map((folder) => FOLDER_ROUTES[folder]);
const links = [
  ...routes.map(({ log, kind }) => ({ href: log.url, label: log.name, note: `${kind} 흐름 로그` })),
  ...routes.flatMap(({ list, kind }) =>
    list ? [{ href: list.url, label: list.name, note: `${kind} 목록` }] : [],
  ),
  ...routes.map(({ tags, tagPath, kind }) => ({
    href: tags,
    label: tagPath,
    note: `${kind} 태그 목록`,
  })),
];
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청하신 페이지가 존재하지 않습니다."
  file={{ title: '페이지를 찾을 수 없습니다', path: '404', url: '/404', kind: 'page' }}
>
  <FlowLog
    lines={linkLines({
      title: '404',
      comment: '요청한 파일을 찾을 수 없다. 주소가 바뀌었거나 없는 파일이다.',
      links,
    })}
  />
</BaseLayout>
