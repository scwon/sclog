---
/**
 * 홈: `posts.log` 흐름 로그. 줄 번호·장 흐름·첫 문장은 모두 글 파일에서 읽는다.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowLog from '../components/flow/FlowLog.astro';
import { getPublishedPosts } from '../utils/blog';
import { flowLines, flowPost } from '../utils/flow';
import { SITE } from '../site';

const posts = await getPublishedPosts();
const flows = await Promise.all(
  posts.map(async (post) => ({ post, flow: flowPost(post, (await render(post)).headings) })),
);
---

<BaseLayout
  title="SCLOG - 개발 블로그"
  description="프론트엔드 개발자의 기술 블로그. 개발 경험과 인사이트를 공유합니다."
  file={{
    title: 'posts.log',
    path: 'posts.log',
    url: '/',
    kind: 'log',
    summary: `글 ${posts.length}편`,
  }}
>
  <FlowLog
    lines={flowLines(flows)}
    brand={SITE.brand}
    author={SITE.author}
    githubUrl={SITE.githubUrl}
  />
</BaseLayout>
