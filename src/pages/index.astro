---
/**
 * 홈: `posts.log` 흐름 로그. 직접 쓴 글을 쌓고 맨 아래 AI 글 칸을 둔다.
 * 줄 번호·장 흐름·첫 문장은 모두 글 파일에서 읽는다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowLog from '../components/flow/FlowLog.astro';
import { getPublishedPosts } from '../utils/blog';
import { homeLines, loadFlows } from '../utils/flow';
import { SITE } from '../site';
import { FOLDER_ROUTES } from '../utils/folder';

const { log } = FOLDER_ROUTES.posts;
const posts = await getPublishedPosts('posts');
const flows = await loadFlows(posts);
const aiWritten = await loadFlows(await getPublishedPosts('ai-written'));
---

<BaseLayout
  title="SCLOG - 개발 블로그"
  description="프론트엔드 개발자의 기술 블로그. 개발 경험과 인사이트를 공유합니다."
  file={{
    title: log.name,
    path: log.name,
    url: log.url,
    kind: 'log',
    summary: `글 ${posts.length}편`,
  }}
>
  <FlowLog lines={homeLines(flows, SITE, aiWritten)} />
</BaseLayout>
