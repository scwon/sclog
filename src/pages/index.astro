---
/**
 * 홈: 루트 디렉터리 뷰 `/`. 블로그 이름·주석 아래 폴더 줄(`posts/ ---- 글 N편`, `ai-written/ ---- 글 M편`)을 둔다.
 * 글이 한 편도 없는 폴더는 줄을 두지 않는다. 폴더의 글은 그 폴더의 디렉터리 뷰와 흐름 로그에서 본다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowLog from '../components/flow/FlowLog.astro';
import { getPublishedPosts } from '../utils/blog';
import { rootLines, type DirEntry } from '../utils/flow';
import { SITE } from '../site';
import { FOLDER_ROUTES, FOLDERS, ROOT } from '../utils/folder';

const folders: DirEntry[] = [];
for (const folder of FOLDERS) {
  const count = (await getPublishedPosts(folder)).length;
  if (count === 0) continue;
  const { dir } = FOLDER_ROUTES[folder];
  folders.push({ href: dir.url, label: dir.name, note: `글 ${count}편` });
}
---

<BaseLayout
  title="SCLOG - 개발 블로그"
  description="프론트엔드 개발자의 기술 블로그. 개발 경험과 인사이트를 공유합니다."
  file={{
    title: ROOT.name,
    path: ROOT.name,
    url: ROOT.url,
    kind: 'root',
    summary: `폴더 ${folders.length}개`,
  }}
>
  <FlowLog lines={rootLines(SITE, folders)} />
</BaseLayout>
