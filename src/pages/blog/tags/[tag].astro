---
/** 태그별 글 `tags/<태그>`: 직접 쓴 글(`posts`) 가운데 그 태그가 붙은 글. */
import TagPosts from '../../../components/tags/TagPosts.astro';
import { getAllTags } from '../../../utils/blog';

export async function getStaticPaths() {
  const tags = await getAllTags('posts');
  return [...tags.keys()].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
---

<TagPosts folder="posts" tag={tag} description={`'${tag}' 태그가 포함된 블로그 글 목록입니다.`} />
