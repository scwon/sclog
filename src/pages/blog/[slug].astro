---
/** 직접 쓴 글 화면 `/blog/<슬러그>/`. 화면은 AI 글과 같은 `PostPage`다. */
import PostPage from '../../components/blog/PostPage.astro';
import { postPaths, type BlogPost } from '../../utils/blog';

/** 직접 쓴 글(`posts`)의 발행 글마다 한 화면. 초안·예약 글은 화면이 없다. */
export function getStaticPaths() {
  return postPaths('posts');
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<PostPage post={post} />
