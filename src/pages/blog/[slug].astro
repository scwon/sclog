---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import Chapter from '../../components/blog/headings/Chapter.astro';
import Section from '../../components/blog/headings/Section.astro';
import Subsection from '../../components/blog/headings/Subsection.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings}>
  <Content components={{ h1: Chapter, h2: Section, h3: Subsection }} />
</BlogPost>
