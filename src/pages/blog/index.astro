---
/** 글 목록 `posts/`: 연도별 글 카드를 흐름 로그 줄로 보인다. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowLog from '../../components/flow/FlowLog.astro';
import { getPublishedPosts } from '../../utils/blog';
import { listLines, loadFlows } from '../../utils/flow';

const posts = await getPublishedPosts('posts');
const flows = await loadFlows(posts);
---

<BaseLayout
  title="블로그"
  description="SCLOG - 개발 블로그의 모든 글 목록입니다."
  file={{
    title: '글 목록',
    path: 'posts/',
    url: '/blog/',
    kind: 'page',
    summary: `글 ${posts.length}편`,
  }}
>
  <FlowLog
    lines={listLines(flows, { title: 'posts/', comment: `모든 글 ${posts.length}편, 최신순` })}
  />
</BaseLayout>
