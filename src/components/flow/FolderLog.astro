---
/**
 * 한 폴더의 흐름 로그 파일(`posts/posts.log`·`ai-written/ai-written.log`): 그 폴더의 글을 연도별로 쌓고 글마다 장 흐름을
 * 잇는다. 이름·주소는 폴더 표(`FOLDER_ROUTES`)에서 읽는다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowLog from './FlowLog.astro';
import { getPublishedPosts } from '../../utils/blog';
import { listLines, loadFlows } from '../../utils/flow';
import { FOLDER_ROUTES, type Folder } from '../../utils/folder';

interface Props {
  folder: Folder;
  title: string;
  description: string;
  /** 2번 줄 주석. */
  comment: string;
}

const { folder, title, description, comment } = Astro.props;
const { log } = FOLDER_ROUTES[folder];
const posts = await getPublishedPosts(folder);
const flows = await loadFlows(posts);
---

<BaseLayout
  title={title}
  description={description}
  file={{
    title: log.name,
    path: log.name,
    url: log.url,
    kind: 'log',
    summary: `글 ${posts.length}편`,
  }}
>
  <FlowLog lines={listLines(flows, { title: log.name, comment, steps: true })} />
</BaseLayout>
