---
/**
 * 폴더 화면(`posts/`·`ai-written/`): 그 폴더의 흐름 로그. 글을 연도별로 쌓고 글마다 장 흐름을 잇는다.
 * 이름·주소는 폴더 표(`FOLDER_ROUTES`)에서 읽는다. 파일 종류는 `dir`이라 열어도 패널은 그대로다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowLog from './FlowLog.astro';
import { getPublishedPosts } from '../../utils/blog';
import { listLines, loadFlows } from '../../utils/flow';
import { FOLDER_ROUTES, type Folder } from '../../utils/folder';

interface Props {
  folder: Folder;
  title: string;
  description: string;
}

const { folder, title, description } = Astro.props;
const { dir, kind } = FOLDER_ROUTES[folder];
const posts = await getPublishedPosts(folder);
const flows = await loadFlows(posts);
---

<BaseLayout
  title={title}
  description={description}
  file={{
    title: dir.name,
    path: dir.name,
    url: dir.url,
    kind: 'dir',
    summary: `글 ${posts.length}편`,
  }}
>
  <FlowLog
    lines={listLines(flows, {
      title: dir.name,
      comment: `${kind} ${posts.length}편, 최신순`,
      steps: true,
    })}
  />
</BaseLayout>
