---
/**
 * ThemeToggle component - 어두운/밝은 테마 전환 버튼
 *
 * - 현재 테마에 따라 Sun/Moon 아이콘 표시
 * - 클릭 시 <html data-theme> 전환 + localStorage 저장
 * - 시스템 테마 변경 감지 (수동 선택 없을 때만)
 */
---

<button type="button" class="theme-toggle" aria-label="테마 전환" title="테마 전환">
  <svg
    class="icon dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    class="icon hidden dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    border-radius: var(--corner-sm);
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .theme-toggle:hover {
    background: var(--border);
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>

<script>
  /** 어두운 테마가 기본이므로 속성이 light일 때만 밝은 테마로 본다. */
  function currentTheme(): 'dark' | 'light' {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function storedTheme(): string | null {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  /**
   * 테마 토글 함수
   */
  function toggleTheme(): void {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // 저장소를 쓸 수 없으면 이번 페이지에서만 바뀐다.
    }
  }

  /**
   * 시스템 테마 변경 감지 리스너
   * 사용자가 수동으로 테마를 선택하지 않은 경우에만 시스템 테마 따름
   */
  function setupSystemThemeListener(): void {
    const mediaQuery = window.matchMedia('(prefers-color-scheme: light)');

    mediaQuery.addEventListener('change', (e) => {
      if (!storedTheme()) {
        document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
      }
    });
  }

  // 버튼 클릭 이벤트 바인딩
  document.querySelector('.theme-toggle')?.addEventListener('click', toggleTheme);

  // 시스템 테마 변경 리스너 설정
  setupSystemThemeListener();
</script>
