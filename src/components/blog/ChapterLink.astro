---
/**
 * 장 주소 복사 버튼. 개요에 오른 장·절 제목 안, 그 줄의 줄 번호 칸에 놓인다(`headings/Heading.astro`).
 * 칸(`.doc-chapter-gutter`) 전체가 hover 영역이고 버튼은 칸 왼쪽 24×24px다. 모양은 2층 ide.css.
 * 버튼은 `hidden`으로 나오고 아래 스크립트가 붙을 때 드러난다. JS가 없으면 보이지 않는다.
 */
interface Props {
  /** 제목 id(MDX가 만든 slug). 장 주소의 해시가 된다. */
  id: string;
  /** 제목 글자. 버튼 이름 `'{제목}' 장 주소 복사`에 쓴다. */
  title: string;
}

const { id, title } = Astro.props;
---

<span class="doc-chapter-gutter">
  <button
    type="button"
    class="doc-chapter-link"
    data-chapter-link={id}
    aria-label={`'${title}' 장 주소 복사`}
    hidden
  >
    <svg
      class="doc-chapter-link-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <svg
      class="doc-chapter-link-done"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </button>
</span>

<script>
  import { showStatusNotice, STATUS_NOTICE_MS } from '@/design-system';
  import { chapterLinkNotice, chapterLinkUrl } from '../../utils/chapter-link';

  /**
   * 장 주소 복사와 들어왔을 때 강조. 번들 스크립트는 한 번만 돌므로 클릭은 `document`에 위임하고,
   * 버튼 드러내기와 강조는 파일이 열릴 때마다(`astro:page-load`) 한다. 강조는 그 장 제목의 `.is-linked`다.
   */
  const BUTTON = '[data-chapter-link]';
  const copiedTimers = new WeakMap<HTMLElement, number>();

  /** id가 장 주소 대상(복사 버튼이 있는 제목)이면 그 제목. */
  function chapterHeading(id: string): HTMLElement | null {
    const heading = document.getElementById(id);
    return heading?.querySelector(`:scope > .doc-chapter-gutter > ${BUTTON}`) ? heading : null;
  }

  /** 강조를 그 장으로 옮긴다. `null`이면 지운다. */
  function markLinked(heading: HTMLElement | null) {
    for (const marked of document.querySelectorAll('.is-linked')) {
      if (marked !== heading) marked.classList.remove('is-linked');
    }
    heading?.classList.add('is-linked');
  }

  function hashId(): string {
    try {
      return decodeURIComponent(location.hash.slice(1));
    } catch {
      return '';
    }
  }

  // 파일이 열릴 때만 해시를 본다. 같은 화면에서 개요 링크로 해시만 바뀌면 page-load가 오지 않아 강조하지 않는다.
  document.addEventListener('astro:page-load', () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(BUTTON)) {
      button.hidden = false;
    }
    const id = hashId();
    markLinked(id ? chapterHeading(id) : null);
  });

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>(BUTTON);
    const id = button?.dataset.chapterLink;
    if (!button || !id) return;
    // ClientRouter의 기록 상태(index·스크롤)를 잃지 않게 지금 state를 그대로 넘긴다. 스크롤하지 않는다.
    history.replaceState(history.state, '', `#${id}`);
    markLinked(chapterHeading(id));
    let copied = false;
    try {
      await navigator.clipboard.writeText(chapterLinkUrl(location, id));
      copied = true;
    } catch {
      copied = false;
    }
    showStatusNotice(chapterLinkNotice(id, copied));
    if (!copied) return;
    window.clearTimeout(copiedTimers.get(button));
    button.dataset.copied = '';
    copiedTimers.set(
      button,
      window.setTimeout(() => delete button.dataset.copied, STATUS_NOTICE_MS),
    );
  });
</script>
