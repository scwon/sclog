---
/**
 * 글 본문의 제목 한 줄. 개요에 오른 장·절 제목(`Astro.locals.chapterLinks`에 id가 있는 제목)이면 줄 번호 칸에
 * 장 주소 복사 버튼을 넣고, 제목은 `aria-labelledby`로 제목 글자만 이름으로 삼는다. 그래서 제목 목록에 버튼
 * 이름이 섞이지 않는다. 그 밖의 제목은 그대로 그린다.
 */
import type { HTMLAttributes } from 'astro/types';
import ChapterLink from '../ChapterLink.astro';

interface Props extends HTMLAttributes<'h2'> {
  level: 2 | 3 | 4;
}

const { level, id, ...rest } = Astro.props;
const Tag = `h${level}` as const;
const title = id ? Astro.locals.chapterLinks?.get(id) : undefined;
// 제목 글자 요소의 id. `:`는 MDX slug에 나오지 않아 다른 제목 id와 겹치지 않는다.
const textId = `${id}:text`;
---

{id && title !== undefined ? (
  <Tag id={id} aria-labelledby={textId} {...rest}>
    <ChapterLink id={id} title={title} />
    <span id={textId}>
      <slot />
    </span>
  </Tag>
) : (
  <Tag id={id} {...rest}>
    <slot />
  </Tag>
)}
