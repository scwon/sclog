---
/**
 * 한 폴더의 디렉터리 뷰(`posts/`·`ai-written/`): `tags/` 폴더 줄, 흐름 로그 파일 줄, 그 폴더의 글 파일 줄(최신순, 연도로
 * 나누지 않음). 이름·주소는 폴더 표(`FOLDER_ROUTES`)에서 읽는다. 줄 모델은 `dirLines`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowLog from '../flow/FlowLog.astro';
import { getAllTags, getPublishedPosts } from '../../utils/blog';
import { dirLines } from '../../utils/flow';
import { FOLDER_ROUTES, type Folder } from '../../utils/folder';

interface Props {
  folder: Folder;
  title: string;
  description: string;
}

const { folder, title, description } = Astro.props;
const { dir, log, tags, kind } = FOLDER_ROUTES[folder];
const posts = await getPublishedPosts(folder);
const tagCount = (await getAllTags(folder)).size;
---

<BaseLayout
  title={title}
  description={description}
  file={{
    title: dir.name,
    path: dir.name,
    url: dir.url,
    kind: 'dir',
    summary: `글 ${posts.length}편`,
  }}
>
  <FlowLog
    lines={dirLines(posts, {
      title: dir.name,
      comment: `${kind} ${posts.length}편, 최신순`,
      entries: [
        { href: tags, label: 'tags/', note: `태그 ${tagCount}개` },
        { href: log.url, label: log.name, note: '흐름 로그' },
      ],
    })}
  />
</BaseLayout>
