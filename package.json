    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "nanostores": "^1.5.5",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satteri": "^0.10.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1"
    }
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "axe-core": "4.14.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "simple-git-hooks": "2.14.0",
    "storybook": "^10.6.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.0.5"
